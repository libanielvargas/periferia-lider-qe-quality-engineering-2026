# Aplicación
PORT=3000
DATABASE_PATH=./src/data/quality-lab.json
RISK_SERVICE_URL=http://127.0.0.1:3000/external/risk
RISK_API_TOKEN=replace-me
# random | approved | rejected (las pruebas E2E lo fijan por proyecto)
RISK_MODE=random

# Pruebas E2E: cada proyecto levanta su servidor con base aislada en test-data/
E2E_PORT_APPROVED=4310
E2E_PORT_REJECTED=4311
# KEEP_TEST_DATA=1 conserva test-data/ para depurar

# Rendimiento (k6)
BASE_URL=http://127.0.0.1:3000
VUS=50
DURATION=5m
P95_MS=800
THINK_TIME=1
