# /etc/systemd/system/periferia-qe.service
# Aplicación de la prueba Líder QE + ejecutor de la suite. Node.js directo, sin Docker.
# Los límites de cgroup evitan que Chromium compita con las aplicaciones existentes.
[Unit]
Description=Periferia IT Group - prueba tecnica Lider QE (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=periferia-qe
Group=periferia-qe
WorkingDirectory=/opt/periferia-qe/app
EnvironmentFile=/etc/periferia-qe/periferia-qe.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

# Recursos para el droplet de 1 GB: el kernel recupera primero la memoria de este servicio
# (MemoryHigh), con techo duro y swap propio acotado; prioridad baja de CPU y disco.
MemoryHigh=380M
MemoryMax=520M
MemorySwapMax=600M
CPUQuota=100%
TasksMax=256
Nice=10
IOWeight=50

# Red: el droplet no tiene firewall en el host (INPUT ACCEPT, ufw inactivo) y server.js escucha
# en 0.0.0.0. El filtro de cgroup limita este servicio (incluidos los servidores de prueba en
# 4310/4311) a localhost y a la red Docker de Caddy, sin tocar el firewall compartido.
IPAddressDeny=any
IPAddressAllow=localhost 172.16.0.0/12

# Aislamiento
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/periferia-qe/app/data /opt/periferia-qe/app/runs /opt/periferia-qe/app/test-data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
