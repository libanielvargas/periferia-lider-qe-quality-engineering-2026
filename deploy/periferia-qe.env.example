# /etc/periferia-qe/periferia-qe.env  (propietario root, permisos 0640, grupo periferia-qe)
NODE_ENV=production
PORT=3300
DATABASE_PATH=/opt/periferia-qe/app/data/quality-lab.json
RISK_MODE=random
RISK_API_TOKEN=definir-en-el-servidor
PLAYWRIGHT_BROWSERS_PATH=/opt/periferia-qe/ms-playwright
QA_RUNNER_MODE=public
QA_RUNS_DIR=/opt/periferia-qe/app/runs
# Caddy llega desde la red Docker qirava-net: solo ese rango puede fijar X-Forwarded-For.
TRUST_PROXY=uniquelocal
QA_RUNNER_WORKERS=1
QA_RUNNER_TIMEOUT_SECONDS=180
QA_RUNNER_COOLDOWN_SECONDS=90
QA_RUNNER_MAX_RUNS_PER_IP_HOUR=4
QA_RUNNER_MAX_RUNS_HOUR=15
# No lanza Chromium si el VPS tiene menos memoria libre que esto (MiB).
QA_RUNNER_MIN_FREE_MB=350
E2E_PORT_APPROVED=4310
E2E_PORT_REJECTED=4311
